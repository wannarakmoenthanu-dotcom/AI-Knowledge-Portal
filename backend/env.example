# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น Git)

# --- จำเป็น ---
GEMINI_API_KEY=ใส่คีย์ของคุณที่นี่

# --- ไม่จำเป็น (มีค่าเริ่มต้นให้แล้ว) ---
# PORT=3000
# NODE_ENV=production
# GEMINI_MODEL=gemini-3.8-flash

# โดเมนที่อนุญาตให้เรียก API จากเบราว์เซอร์ คั่นด้วยจุลภาค (ตอนขึ้นระบบจริงใส่โดเมนเว็บของคุณ)
# ALLOWED_ORIGINS=https://portal.example.com

# ถ้าอยู่หลัง proxy/load balancer (Render, Cloud Run ฯลฯ) ให้ตั้งเป็น 1
# TRUST_PROXY=1

# ขีดจำกัดต่าง ๆ
# MAX_QUESTION_LENGTH=2000
# AI_TIMEOUT_MS=30000
# QUESTION_RATE_PER_MIN=10
# API_RATE_PER_15MIN=300
